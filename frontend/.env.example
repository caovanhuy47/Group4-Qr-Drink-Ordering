# ==============================================================================
# Huy CV — Quán Vỉa Hè (Frontend Environment Configuration)
# ==============================================================================

# 1. Cấu hình API Backend:
# - Để trống (mặc định) khi chạy dev: Vite Proxy sẽ tự động chuyển tiếp request /api sang http://localhost:3000
# - Khi triển khai production hoặc backend độc lập: điền URL đầy đủ (ví dụ: https://api.huycv.vn)
VITE_API_BASE_URL=

# 2. Cấu hình địa chỉ mạng LAN dùng để sinh mã QR cho điện thoại quét:
# - Mặc định tự động nhận diện IP Wi-Fi đã cấu hình (192.168.12.75) hoặc origin của trình duyệt
# - Khi đổi mạng Wi-Fi khác, cập nhật địa chỉ IPv4 mới tại đây:
VITE_LAN_HOST=192.168.12.75

# 3. Hoặc chỉ định trực tiếp toàn bộ Base URL công khai cho mã QR:
# VITE_PUBLIC_URL=http://192.168.12.75:5173

